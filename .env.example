# Cuenta técnica de Oracle usada por el backend para consultar planilla_digital.
ORACLE_USER=cuenta_tecnica
ORACLE_PASSWORD=cambia_esta_clave
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=servicio
ORACLE_SCHEMA=DIGITALIZACION

# Almacenamiento privado y límite máximo de cada carga multipart (2 GiB).
FOLIO_DATA_DIR=data
MAX_INGEST_UPLOAD_BYTES=2147483648

# En producción, habilitar cookies Secure cuando Folio se publique con HTTPS.
COOKIE_SECURE=false

# Cobertura MSP: se descarga el PDF que genera la propia página del MSP (Chrome headless). Por normativa
# no existe generación local de la hoja.
# Ruta de Chrome/Chromium si no está en una ubicación estándar (también busca en ~/.cache/ms-playwright).
# CHROME_PATH=
# Solo si Chrome no puede usar su sandbox en el servidor (Ubuntu con userns restringido):
# COBERTURA_CHROME_NO_SANDBOX=true
